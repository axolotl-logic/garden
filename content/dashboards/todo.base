filters:
  and:
    - file.folder == "notes"
formulas:
  backlink_count: file.backlinks.length
  forward link count: file.links.length
  Magic: ((file.size / 100) + file.backlinks.length *0.8 + file.links.length * 0.8).round(2)
properties:
  formula.backlink_count:
    displayName: backlink count
views:
  - type: cards
    name: Issolated
    filters:
      and:
        - formula.backlink_count == 0
        - formula["forward link count"] == 0
    order:
      - file.name
      - formula.backlink_count
      - formula.forward link count
      - file.size
      - formula.Magic
    sort:
      - property: formula.Magic
        direction: ASC
    columnSize:
      file.name: 527
      formula.backlink_count: 191
      formula.forward link count: 196
  - type: list
    name: By tag
    groupBy:
      property: file.tags
      direction: ASC
    order:
      - file.name
      - formula.backlink_count
      - formula.forward link count
    sort:
      - property: formula.Magic
        direction: ASC
