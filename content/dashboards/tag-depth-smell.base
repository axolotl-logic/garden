formulas:
  Untitled: file.tags.map(value.split("/").length).reduce(if(value < 2, true, acc), false)
  too deep: file.tags.map(value.split("/").length).reduce(if(value > 2, true, acc), false)
properties:
  formula.Untitled:
    displayName: too shallow
  formula.too deep:
    displayName: too deep
views:
  - type: table
    name: Table
    filters:
      and:
        - "!file.tags.isEmpty()"
        - file.folder == "notes"
        - or:
            - formula["too deep"] == true
            - formula.Untitled == true
    order:
      - file.name
      - formula.Untitled
      - formula.too deep
    sort: []
